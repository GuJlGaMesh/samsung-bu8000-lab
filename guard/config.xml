<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://tvprivacyguard.local" version="1.0.3" viewmodes="maximized">
<tizen:application id="tvprivgrd1.app" package="tvprivgrd1" required_version="6.5"/>
<author>Local device owner</author><content src="index.html"/><icon src="icon.png"/><name>TV Privacy Guard</name>
<feature name="http://tizen.org/feature/screen.size.all"/><feature name="http://tizen.org/feature/web.service"/>
<tizen:privilege name="http://tizen.org/privilege/internet"/><tizen:privilege name="http://tizen.org/privilege/filesystem.read"/><tizen:privilege name="http://tizen.org/privilege/unlimitedstorage"/><tizen:privilege name="http://tizen.org/privilege/application.launch"/>
